<launch>
  <node pkg="min_snap_gen" type="rounded_rectangle_node" name="min_snap_traj" output="screen" clear_params="true">
    <rosparam file="$(find min_snap_gen)/config/rounded_rectangle.yaml" command="load"/>
    <param name="optimization/vmax" value="1.5" />
    <param name="num_loops" value="1.0" />

    <remap from="/min_snap_traj/trajectory" to="/mavros/setpoint_trajectory/local" />
  </node>
</launch>
